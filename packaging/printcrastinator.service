[Unit]
Description=Printcrastinator daemon and web UI
# Start once the desktop session is up so the morning window and notification can appear.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/printcrastinator/src
ExecStart=/usr/bin/uv run --frozen --project %h/.local/share/printcrastinator/src printcrastinator serve
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
