# Qian Anjet 58 mini thermal printer (STMicroelectronics USB printer class)
# Must sort before 73-seat-late.rules, otherwise TAG+="uaccess" has no effect.
# Grants the active seat user access to /dev/usb/lp* without adding them to group lp.
SUBSYSTEM=="usbmisc", KERNEL=="lp*", ATTRS{idVendor}=="0456", ATTRS{idProduct}=="0808", TAG+="uaccess"
